# ============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# Never commit your real .env file to version control.
# ============================================================================

# Server HTTP port
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string (used by Prisma 7 & @prisma/adapter-pg)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sme_financial_intelligence_dev?schema=public
